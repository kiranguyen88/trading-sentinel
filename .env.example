GEMINI_API_KEY=your_gemini_api_key_here

# Discord webhook — all alerts go here
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# ── Supabase ──────────────────────────────────────────────────────────────
# service_role (secret) key. RLS is on with no policies, so this key is the
# ONLY way to read or write any table. Never commit it, never expose it to the
# browser. Supabase dashboard → Project Settings → API Keys → service_role.
# SUPABASE_URL is optional — trading_bot.py defaults to the right project.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── Auth ──────────────────────────────────────────────────────────────────
# Signs the session cookie. Any long random string; keep it stable or every
# restart logs everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_long_random_session_secret

# Opens /register when truthy. Leave unset to keep sign-up closed and create
# accounts with: python create_user.py <email> <password> [--owner]
# ALLOW_REGISTRATION=1

# Guards /cron/* and /admin/bootstrap
CRON_SECRET=your_random_cron_secret

# Used once by POST /admin/bootstrap to create the owner account
# OWNER_EMAIL=you@example.com
# OWNER_PASSWORD=your_first_login_password

PORT=5000
